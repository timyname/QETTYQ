APP_URL=http://localhost:3000
CITY_ID=astana
TIME_ZONE=Asia/Almaty
LLM_ENABLED=false
LLM_PROVIDER=deterministic
LLM_MODEL=
MAP_PROVIDER=osm
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
ROUTING_PROVIDER=estimated
INGESTION_ENABLED=true
MAX_PROVIDER_REQUESTS=2
SPEND_CAP=0
ALLOW_ESTIMATED_ROUTES=true
OPENAI_API_KEY=
QETTYQ_AI_ENABLED=false
QETTYQ_AI_TEST_BUDGET_APPROVED=false
QETTYQ_AI_PUBLIC_ENABLED=false
QETTYQ_AI_PUBLIC_BUDGET_APPROVED=false
QETTYQ_PUBLIC_ROUTING_ENABLED=false
QETTYQ_ROUTING_PROVIDER=fossgis_foot
OPENROUTESERVICE_API_KEY=
# VPS only: Node24 startup, explicit persistent volume and verified migration proof.
# Leave unset for local dev. Never invent/reset an empty ledger export.
QETTYQ_DEPLOYMENT=
QETTYQ_DATABASE_PATH=
QETTYQ_D1_LEDGER_EXPORT_PATH=
QETTYQ_GOOGLE_PLACES_ENABLED=false
QETTYQ_GOOGLE_BUDGET_APPROVED=false
# Server credential; never implicitly exposed through browser config.
2GIS_API_KEY=
# Separate browser MapGL key, with Map Tiles/domain restrictions verified first.
# Publishing requires explicit owner approval; these defaults keep OSM active.
QETTYQ_2GIS_BROWSER_KEY=
QETTYQ_2GIS_BROWSER_KEY_APPROVED=false
# Temporary reuse of a demo key requires explicit owner approval + expiry.
# Prefer a separate domain-restricted browser key for production.
QETTYQ_2GIS_REUSE_DEMO_KEY_APPROVED=false
QETTYQ_2GIS_DEMO_PUBLIC_UNTIL=
# Optional real published 2GIS Style Editor UUID, not a URL.
QETTYQ_2GIS_MAP_STYLE_ID=
