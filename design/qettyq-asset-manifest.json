  "promptPack": {
    "prefix": "QETTYQ visual system, Astana modern urban editorial mood, winter pearl and cool mist palette, deep steppe jade structure, one restrained acid-lime detail, tactile matte materials, soft daylight, subtle depth and half-shadows, modern Kazakhstan without literal folklore, premium but calm, no text, no logos, no factual map.",
    "negative": "legible text, letters, numbers, UI buttons, real venue claim, fake map, fake event poster, fake ticket, brand logos, watermark, neon cyberpunk, purple AI gradient, generic SaaS illustration, glossy plastic, dating app people, yurt cliché, national costume, clutter, excessive glassmorphism.",
    "prompts": {
      "P-HOME-02": "Four coordinated 1:1 activity illustrations: abstract ceramic plate landscape; flowing route ribbon; tactile clay and percussion forms; unexpected architectural portal. Same light, camera distance and material family, strong central symbols.",
      "P-CITY-03A": "Horizontal 2:1 abstract Astana winter atmosphere, broad open sky, light futuristic civic geometry, wind-shaped route arc and river-like reflection, central 80 percent crop-safe.",
      "P-CITY-03B": "Horizontal 2:1 abstract Almaty foothill atmosphere, layered pale mineral planes and cool blue-green air, restrained mountain geometry, central 80 percent crop-safe.",
      "P-INTEREST-01-15": "3:4 mobile discovery card for CATEGORY and SYMBOL_DESCRIPTION, abstract urban leisure without a specific venue or event, strong central subject, uncluttered lower 34 percent for code-rendered title.",
      "P-FEED-14": "3:4 event-category illustration for a contemporary indoor cultural evening, abstract light, acoustic curves, fabric and architectural folds, no performer faces or real venue, top-center focal point.",
      "P-DETAIL-20": "3:4 generic event-detail illustration, abstract stage light and audience-space geometry, no identifiable artist, real poster or text, clean lower transition area.",
      "P-PLACE-21": "3:4 honest place-category illustration for a creative studio, tactile clay tools and warm neutral interior abstraction, no real venue claim or schedule, lower zone clear for label.",
      "P-MOVIE-22": "3:4 posterless cinema artwork, abstract projection beam and dark acoustic volume, no film characters, title, typography or franchise likeness, clear area for code metadata.",
      "P-ORGANIZER-35": "3:4 event-creation atmosphere, modular stage blocks, calendar plane, contact ribbon and audience-space circles, modern civic Astana, central 70 percent focal, quiet lower 20 percent.",
      "P-ALMATY-44": "3:4 abstract Almaty expansion artwork, layered foothill planes, crisp morning air, pale mineral stone, cool blue-green mist and one deep-jade route ribbon, quiet lower 30 percent."
    }
  },
  "exports": {
    "masterRaster": { "format": "PNG", "colorSpace": "sRGB", "delivery": false },
    "clientPreferred": ["AVIF", "WebP"],
    "clientFallback": ["PNG", "JPEG"],
    "qualityGuidance": { "avif": "55-65", "webp": "78-84" },
    "vector": { "format": "SVG", "requireViewBox": true, "allowEmbeddedRaster": false, "allowScripts": false, "allowExternalReferences": false },
    "rules": ["No upscaling above master", "@2x is twice the CSS display box", "Strip GPS and EXIF from public derivatives", "Keep rights metadata in provenance records", "Use picture: AVIF then WebP then fallback"]
  },
  "provenanceRequiredFields": [
    "kind",
    "sourceUrl",
    "author",
    "license",
    "licenseUrl",
    "retrievedAt",
    "rightsReviewedAt",
    "allowedUses.display",
    "allowedUses.crop",
    "allowedUses.persist",
    "allowedUses.redistribute",
    "contentHash",
    "focalPoint"
  ],
  "qa": [
    "No baked UI text, facts, maps, routes, markers, controls or provider logos",
    "All icon-only controls have accessible names and at least 44x44 CSS px targets",
    "Dock is exactly home, search, map and profile; settings is top-right",
    "Bookmark means save; Heart means interest; skip is neutral",
    "Generated illustrations are labelled and never treated as evidence",
    "Real media has reviewed provenance and allowed-use flags",
    "Feed, map, detail and assistant reuse the same candidate media identity",
    "Crops pass 3:4, 4:3 and 1:1 focal-point review",
    "AVIF, WebP and fallback render; public derivatives contain no GPS/EXIF",
    "360x800, 390x844, 430x932 and 200-percent-text layouts pass",
    "Reduced-motion variant contains no route draw, indicator travel or repeating pulse"
  ]
}
